    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.6.2",
    "mongodb": "^6.21.0",
    "mysql2": "^3.15.3",
    "uuid": "^11.0.5",
    "zod": "^3.25.76"
  }
