# Local ports
DMS_API_PORT=3101
DMS_UI_PORT=3102
CHATBOT_UI_PORT=3000
WRAPPER_API_PORT=3201
AGENTIC_API_PORT=3202
MASTER_AGENT_PORT=3301
METADATA_AGENT_PORT=3302
FETCH_DOCUMENT_AGENT_PORT=3303
OCR_AGENT_PORT=3304
VECTOR_INGESTION_AGENT_PORT=3305
ANSWER_AGENT_PORT=3306
DMS_QUERY_MCP_PORT=3401
DMS_FETCH_MCP_PORT=3402
VECTOR_MCP_PORT=3403

# UI URLs
VITE_DMS_API_URL=http://localhost:3101
VITE_WRAPPER_API_URL=http://localhost:3201

# API URLs
DMS_API_URL=http://localhost:3101
WRAPPER_API_URL=http://localhost:3201
MASTER_AGENT_URL=http://localhost:3301
METADATA_AGENT_URL=http://localhost:3302
FETCH_DOCUMENT_AGENT_URL=http://localhost:3303
OCR_AGENT_URL=http://localhost:3304
VECTOR_INGESTION_AGENT_URL=http://localhost:3305
ANSWER_AGENT_URL=http://localhost:3306
DMS_QUERY_MCP_URL=http://localhost:3401
DMS_FETCH_MCP_URL=http://localhost:3402
VECTOR_MCP_URL=http://localhost:3403

# Persistence
DMS_STORAGE_MODE=local
DMS_LOCAL_DATA_DIR=.local-data/dms-api
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=document_ai
MYSQL_USER=document_ai
MYSQL_PASSWORD=document_ai
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=document_ai
MONGODB_GRIDFS_BUCKET=dms_documents
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# Security and limits
LOCAL_AUTH_MODE=demo
LOCAL_API_KEY=local-dev-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3102
MAX_PDF_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=application/pdf

# Local model catalog
MODEL_BASE_URL=http://host.docker.internal:12434/engines/v1
MODEL_AVAILABLE_NAMES=ai/gpt-oss:latest,ai/ministral3:14B,ai/qwen3-vl:latest,ai/gemma4:latest,ai/gemma4:31B,ai/mxbai-embed-large:latest
MODEL_DEFAULT_OCR_NAME=ai/qwen3-vl:latest
MODEL_ALLOWED_OCR_NAMES=ai/qwen3-vl:latest
MODEL_DEFAULT_AGENT_NAME=ai/gpt-oss:latest
MODEL_ALLOWED_AGENT_NAMES=ai/gpt-oss:latest,ai/ministral3:14B,ai/gemma4:latest,ai/gemma4:31B
MODEL_EMBEDDING_NAME=ai/mxbai-embed-large:latest
MODEL_FALLBACK_AGENT_NAME=ai/gemma4:latest
MODEL_FALLBACK_OCR_NAME=ai/qwen3-vl:latest
